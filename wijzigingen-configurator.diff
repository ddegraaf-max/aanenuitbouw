+
+  return `<div class="start-chips">${flex}${chips}</div>
+    ${planning ? `<div class="avail-legend" style="margin-top:14px">
+      <span><i class="dot dot-green"></i>Ruimte beschikbaar</span>
+      <span><i class="dot dot-orange"></i>Beperkte ruimte</span>
+      <span><i class="dot dot-red"></i>Volgeboekt — wachtlijst</span>
+    </div>` : ''}`;
+}
