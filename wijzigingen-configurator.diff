+}
+
+/**
+ * Leest de gekozen bestanden en verkleint ze in de browser tot maximaal
+ * 1600 px met JPEG-kwaliteit 0,82. Een telefoonfoto van 4 MB wordt daarmee
+ * doorgaans 200 tot 400 kB. Dat is nodig: ongewijzigd zouden drie foto's de
+ * aanvraag te groot maken voor de e-mail.
+ */
+async function verwerkFotos(bestanden) {
+  const melding = document.getElementById('fotoMelding');
+  const zeg = (tekst, soort) => { if (melding) { melding.textContent = tekst; melding.className = 'foto-melding ' + (soort || ''); } };
+  const ruimte = 3 - (state.contact.photos || []).length;
+  if (ruimte <= 0) { zeg('Maximaal drie foto\'s.', 'fout'); return; }
+
+  zeg('Foto\'s verkleinen…');
+  let toegevoegd = 0;
+  for (const bestand of Array.from(bestanden).slice(0, ruimte)) {
+    if (!/^image\/(jpeg|png|webp)$/.test(bestand.type)) { zeg('Alleen JPG, PNG of WEBP.', 'fout'); continue; }
+    if (bestand.size > 25 * 1024 * 1024) { zeg('Die foto is groter dan 25 MB.', 'fout'); continue; }
+    try {
+      const klein = await verkleinFoto(bestand);
+      state.contact.photos.push(klein);
+      toegevoegd++;
+    } catch (e) {
+      zeg('Deze foto kon niet worden gelezen.', 'fout');
+    }
+  }
+  if (toegevoegd) {
+    render();
+    const m2 = document.getElementById('fotoMelding');
+    if (m2) m2.textContent = toegevoegd === 1 ? 'Foto toegevoegd.' : toegevoegd + ' foto\'s toegevoegd.';
+  }
+}
+
+function verkleinFoto(bestand) {
+  return new Promise((klaar, mislukt) => {
+    const lezer = new FileReader();
+    lezer.onerror = () => mislukt(new Error('lezen mislukt'));
+    lezer.onload = () => {
+      const img = new Image();
+      img.onerror = () => mislukt(new Error('geen geldige afbeelding'));
+      img.onload = () => {
+        const MAX = 1600;
+        const schaal = Math.min(1, MAX / Math.max(img.width, img.height));
+        const canvas = document.createElement('canvas');
+        canvas.width = Math.max(1, Math.round(img.width * schaal));
+        canvas.height = Math.max(1, Math.round(img.height * schaal));
+        const ctx = canvas.getContext('2d');
+        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
+        const dataUrl = canvas.toDataURL('image/jpeg', 0.82);
+        klaar({
+          type: 'image/jpeg',
+          data: dataUrl.split(',')[1],
+          preview: dataUrl,
+          bytes: Math.round(dataUrl.length * 0.75),
+        });
+      };
+      img.src = lezer.result;
+    };
+    lezer.readAsDataURL(bestand);
+  });
+}
