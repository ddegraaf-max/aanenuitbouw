+      title="${vol ? 'Volgeboekt — u komt op de wachtlijst' : ''}">
+      <span class="m-name">${monthName(ym)}</span>
+      ${st ? `<span class="m-status">${MONTH_STATUS_LABEL[st]}</span>` : ''}
+    </button>`;
+  }).join('');
+
+  const flex = `<button type="button" class="start-chip flex ${gekozen === 'flexibel' ? 'gekozen' : ''}"
+    onclick="kiesStartMaand('flexibel')">
+    <span class="m-name">Flexibel</span><span class="m-status">Zo snel mogelijk</span>
