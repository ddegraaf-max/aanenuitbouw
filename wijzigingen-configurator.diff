+/* ---------- Bodemcheck ---------- */
+.bodemcheck-wrap {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
+  gap: 40px;
+  align-items: start;
+  margin-top: 36px;
+}
+.bodemcheck-intro p {
+  color: var(--color-ink-light);
+  line-height: 1.7;
+  margin: 0 0 18px;
+}
+.bodemcheck-punten {
+  list-style: none;
+  padding: 0;
+  margin: 0 0 18px;
+}
+.bodemcheck-punten li {
+  position: relative;
+  padding-left: 28px;
+  margin-bottom: 10px;
+  color: var(--color-ink);
+}
+.bodemcheck-punten li::before {
+  content: '';
+  position: absolute;
+  left: 0;
+  top: 0.45em;
+  width: 14px;
+  height: 8px;
+  border-left: 2px solid var(--color-primary);
+  border-bottom: 2px solid var(--color-primary);
+  transform: rotate(-45deg);
+}
+.bodemcheck-klein {
+  font-size: 13px;
+  color: var(--color-mute);
+  line-height: 1.6;
+  margin: 0;
+}
+.bodemcheck-kaart {
+  background: var(--color-paper);
+  border: 1px solid var(--color-line);
+  border-radius: 14px;
+  padding: 26px 24px;
+  box-shadow: 0 18px 40px -28px rgba(26, 37, 64, 0.4);
+}
+.bodemcheck-kaart label {
+  display: block;
+  font-size: 13px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  color: var(--color-ink);
+  margin-bottom: 10px;
+}
+.bodemcheck-veld {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.bodemcheck-veld input {
+  width: 100%;
+  font: inherit;
+  font-size: 16px;
+  padding: 13px 14px;
+  border: 1px solid var(--color-line);
+  border-radius: 10px;
+  background: var(--color-bg-soft);
+  color: var(--color-ink);
+}
+.bodemcheck-veld input:focus-visible {
+  outline: 2px solid var(--color-primary);
+  outline-offset: 1px;
+}
+.bodemcheck-veld button {
+  font: inherit;
+  font-size: 15px;
+  font-weight: 700;
+  padding: 13px 18px;
+  border: 0;
+  border-radius: 10px;
+  background: var(--color-primary);
+  color: #fff;
+  cursor: pointer;
+  transition: background-color 0.15s ease;
+}
+.bodemcheck-veld button:hover {
+  background: var(--color-primary-hover);
+}
+.bodemcheck-hint {
+  font-size: 13px;
+  color: var(--color-mute);
+  margin: 14px 0 0;
+}
+.bodemcheck-hint a {
+  color: var(--color-primary);
+}
+@media (max-width: 860px) {
+  .bodemcheck-wrap {
+    grid-template-columns: 1fr;
+    gap: 28px;
+  }
+}
+
