+// ─── Antispam ───
+
+// Wanneer de bezoeker de pagina opende. Het verschil met het moment van
+// versturen gaat mee in de aanvraag; de server weigert wat binnen drie seconden
+// terugkomt, want dat is geen mens dat naam, e-mail, adres en een configuratie
+// heeft ingevuld.
+const _geopendOp = Date.now();
+
+// Turnstile van Cloudflare, alleen als de server een sitekey teruggeeft. Staat
+// die er niet, dan gebeurt er niets en werkt het formulier zoals altijd.
+let _turnstileSitekey = '';
+let _turnstileToken = '';
+
+async function laadAntispam() {
+  try {
+    const res = await fetch('/api/publieke-config');
+    if (!res.ok) return;
+    const cfg = await res.json();
+    if (!cfg.turnstileSitekey) return;
+    _turnstileSitekey = cfg.turnstileSitekey;
+    await new Promise((klaar, mislukt) => {
+      const el = document.createElement('script');
+      el.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
+      el.async = true;
+      el.onload = klaar;
+      el.onerror = mislukt;
+      document.head.appendChild(el);
+    });
+    plaatsTurnstile();
+  } catch (e) {
+    // Geen Turnstile is geen ramp: de andere sloten staan nog overeind.
+    console.warn('Turnstile niet geladen:', e && e.message);
+  }
+}
+
+function plaatsTurnstile() {
+  if (!_turnstileSitekey || !window.turnstile) return;
+  const doel = document.getElementById('turnstileDoel');
+  if (!doel || doel.dataset.gezet === '1') return;
+  doel.dataset.gezet = '1';
+  window.turnstile.render(doel, {
+    sitekey: _turnstileSitekey,
+    action: 'offerte',
+    callback: (token) => { _turnstileToken = token; },
+    'expired-callback': () => { _turnstileToken = ''; },
+    'error-callback': () => { _turnstileToken = ''; },
+  });
+}
+
