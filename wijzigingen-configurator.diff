+// hem aanroept, en valt de hele pagina om met "Cannot access before
+// initialization". Dat is eerder gebeurd en het kost onnodig veel zoektijd.
+let _publicPlanning = null;
+
+/**
+ * Keuze over de bouwtekeningen. Drie antwoorden, elk met een ander gevolg voor
+ * ons: bij "heb ik" kan de constructeur ze meteen inzien, bij "opvragen" krijgt
+ * de klant de juiste link naar zijn gemeente, en bij "geen" weten we dat er een
+ * opname ter plaatse nodig is en kunnen we dat in de offerte meenemen.
+ */
+const TEKENING_KEUZES = [
+  { waarde: 'heb-ik',    titel: 'Ja, die heb ik',        uitleg: 'U kunt ze later per e-mail meesturen.' },
+  { waarde: 'opvragen',  titel: 'Nee, wil ik opvragen',  uitleg: 'Wij laten zien waar dat bij uw gemeente kan.' },
+  { waarde: 'geen',      titel: 'Nee, en dat lukt niet', uitleg: 'Dan nemen we de bestaande situatie ter plaatse op.' },
+];
+
+function renderTekeningKeuze() {
+  const gekozen = state.contact.tekeningen;
+  const knoppen = TEKENING_KEUZES.map(k => `<button type="button"
+      class="tk-keuze ${gekozen === k.waarde ? 'gekozen' : ''}"
+      onclick="kiesTekeningen('${k.waarde}')">
+      <span class="tk-titel">${k.titel}</span>
+      <span class="tk-uitleg">${k.uitleg}</span>
+    </button>`).join('');
+
+  let extra = '';
+  if (gekozen === 'opvragen') {
+    extra = state.contact.gemeente
+      ? `<div class="tk-archief" id="tkArchief">Bezig met opzoeken voor gemeente ${escAttr(state.contact.gemeente)}…</div>`
+      : `<div class="tk-archief">Vul hierboven het adres van de woning in, dan zoeken wij op waar u bij uw gemeente het bouwdossier kunt inzien.</div>`;
