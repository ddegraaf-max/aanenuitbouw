+<script>
+/* Versiestempel ophalen. Twee dingen worden hiermee zichtbaar:
+   - dat DIT bestand nieuw is (het element bestaat alleen in deze versie)
+   - welke versie de SERVER heeft (uit /bodemcheck/api/versie)
+   Wijken die na een upload niet mee, dan is de deploy niet aangekomen of kijk
+   je naar een gecachte pagina. */
+(function () {
+  var el = document.getElementById('siteVersie');
+  if (!el) return;
+  el.textContent = 'versie laden…';
+  fetch('/bodemcheck/api/versie', { cache: 'no-store' })
+    .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
+    .then(function (d) {
+      el.textContent = 'versie ' + d.versie;
+      el.title = 'Gestart ' + String(d.gestart).replace('T', ' ').slice(0, 16) + ' UTC · klik voor details';
+      el.addEventListener('click', function () {
+        if (el.querySelector('pre')) { el.querySelector('pre').remove(); return; }
+        var pre = document.createElement('pre');
+        var regels = ['site      ' + d.versie, 'assets    ' + d.assetVersie, 'node      ' + d.node, 'gestart   ' + d.gestart];
+        for (var k in d.bestanden) regels.push((k + '            ').slice(0, 20) + d.bestanden[k]);
+        pre.textContent = regels.join('\n');
+        el.appendChild(pre);
+      });
+    })
+    .catch(function () { el.textContent = 'versie onbekend'; });
+})();
+</script>
