<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titel %></title>
<style>
  /* Neutrale omgeving, plus een simpele nepnavigatie om te zien of het
     fragment netjes binnen een bestaande layout valt. */
  body { margin: 0; font-family: system-ui, sans-serif; }
  .nep-nav {
    display: flex; gap: 1.5rem; align-items: center;
    padding: 1rem 1.5rem; background: #fff; border-bottom: 1px solid #ddd;
    font-size: 0.9rem;
  }
  .nep-nav strong { margin-right: auto; }
  .nep-voet { padding: 2rem 1.5rem; background: #222; color: #bbb; font-size: 0.85rem; }
</style>
</head>
<body>

<nav class="nep-nav">
  <strong>Aanenuitbouw.nl</strong>
  <a href="#">Aanbouw</a><a href="#">Uitbouw</a><a href="#">Werkwijze</a><a href="#">Contact</a>
</nav>

<%- include(fragmentPad) %>

<footer class="nep-voet">
  Nepvoet van de preview — hier komt jouw eigen footer-partial.
</footer>

</body>
</html>
