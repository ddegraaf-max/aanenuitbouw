# Sondeertool — alle instellingen zijn optioneel, er zijn werkende defaults.

# Fictieve data i.p.v. de echte BRO. Handig lokaal, NOOIT in productie.
# BRO_MOCK=1

# Publieke BRO-uitgifteservice voor geotechnisch sondeeronderzoek (CPT).
# Geen authenticatie, geen kosten.
# BRO_CPT_BASE=https://publiek.broservices.nl/sr/cpt/v1
# BRO_REGISTRATIE_VANAF=2017-01-01
# BRO_TIMEOUT_MS=20000

# Hoeveel sonderingen volledig worden uitgelezen per opvraging.
# Hoger = completer beeld, maar elke XML is 0,5-3 MB.
# SONDEER_MAX_DETAILS=3

# Adres opzoeken (PDOK Locatieserver, open data).
# PDOK_LOCATIESERVER=https://api.pdok.nl/bzk/locatieserver/search/v3_1

# Alleen nodig voor logging en het opslaan van aanvragen.
# DATABASE_URL=postgresql://...
# PGSSL=disable
